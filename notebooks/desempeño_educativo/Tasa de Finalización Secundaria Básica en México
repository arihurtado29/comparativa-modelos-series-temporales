DELO 5:** TRANSFORMER\n","\n","La LSTM procesa los datos en orden y se enfoca más en lo reciente, mientras que el Transformer analiza todo al msimo tiempo y puede identificar qué momento son más importantes. Por eso, Transformer es más potente para captar patrones complejos y es una tecnología mas avanzada."],"metadata":{"id":"7Ih0vebd0yNI"}},{"cell_type":"code","source":["#Definición del Bloque Encoder del Transformer\n","def transformer_encoder(inputs, head_size, num_heads, ff_dim, dropout=0):\n","    # Normalización y Atención\n","    x = layers.LayerNormalization(epsilon=1e-6)(inputs)\n","    x = layers.MultiHeadAttention(key_dim=head_size, num_heads=num_heads, dropout=dropout)(x, x)\n","    x = layers.Dropout(dropout)(x)\n","    res = x + inputs #Conexión residual\n","\n","    #Feed Forward (Capa de Red Neuronal Convencional)\n","    x = layers.LayerNormalization(epsilon=1e-6)(res)\n","    x = layers.Conv1D(filters=ff_dim, kernel_size=1, activation=\"relu\")(x)\n","    x = layers.Dropout(dropout)(x)\n","    x = layers.Conv1D(filters=inputs.shape[-1], kernel_size=1)(x)\n","    return x + res #Segunda conexión residual\n","\n","#Construcción del Modelo Completo\n","def build_transformer(input_shape, head_size, num_heads, ff_dim, num_transformer_blocks, mlp_units, dropout=0, mlp_dropout=0):\n","  inputs = layers.Input(shape=input_shape)\n","  x = inputs\n","  #Podemos aplicar varios bloques de atención\n","  for _ in range(num_transformer_blocks):\n","    x = transformer_encoder(x, head_size, num_heads, ff_dim, dropout)\n","\n","\n","  x = layers.GlobalAveragePooling1D(data_format=\"channels_last\")(x) #Ajustado para series temporales\n","  for dim in mlp_units:\n","    x = layers.Dense(dim, activation=\"relu\")(x)\n","    x = layers.Dropout(mlp_dropout)(x)\n","\n","  outputs = layers.Dense(1)(x) #Predicción del precio\n","  return models.Model(inputs, outputs)\n","\n","#Configuración para 20 días\n","input_shape = (look_back, 1)\n","\n","model_trans = build_transformer(input_shape, head_size=64, num_heads=2, ff_dim=2, num_transformer_blocks=2, mlp_units=[64], dropout=0.1)\n","\n","model_trans.compile(loss=\"mean_squared_error\", optimizer='adam')\n","\n","#Entrenamiento\n","print(f\"Entrenando Transformer...\")\n","model_trans.fit(X_train, y_train, epochs=30, batch_size=4, verbose=1)\n","\n","#Predicción y Desencalado\n","test_predict_trans = model_trans.predict(X_test)\n","test_predict_trans = scaler.inverse_transform(test_predict_trans)\n","\n","print(\"Transformer completado y datos escalados\")\n","\n","#Resultados\n","print(f\"Valor Real final: {y_test_real[-1][0]:.2f}\")\n","print(f\"Predicción final Transformer: {test_predict_trans[-1][0]:.2f}\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"6o2Gumoy19ng","outputId":"3ddca44c-0354-4df5-ef14-20295511b94b","executionInfo":{"status":"ok","timestamp":1775859397974,"user_tz":360,"elapsed":9676,"user":{"displayName":"ARIANNA MONSERRATT HURTADO RAMOS","userId":"12283955907500007694"}}},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Entrenando Transformer...\n","Epoch 1/30\n","\u001b[1m2/2\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m6s\u001b[0m 45ms/step - loss: 0.5844\n","Epoch 2/30\n","\u001b[1m2/2\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m0s\u001b[0m 38ms/step - loss: 0.5442\n","Epoch 3/30\n","\u001b[1m2/2\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m0s\u001b[0m 32ms/step - loss: 0.5025\n","Epoch 4/30\n","\u001b[1m2/2\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m0s\u001b[0m 35ms/step - loss: 0.4574\n","Epoch 5/30\n","\u001b[1m2/2\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m0s\u001b[0m 32ms/step - loss: 0.4120 \n","Epoch 6/30\n","\u001b[1m2/2\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m0s\u001b[0m 33ms/step - loss: 0.367