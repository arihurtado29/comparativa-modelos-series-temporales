M, Dropout\n","from tensorflow.keras import layers, models\n","\n","\n","# Configuraciones usadas para que las gráficas se vean de alta calidad\n","%matplotlib inline\n","plt.rcParams['figure.figsize'] = (12, 6)\n","sns.set_style('whitegrid')"],"metadata":{"id":"Ga0wyh0_8loL"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["**OBTENCIÓN DEL DATA SET: BITCOIN HISTORICAL DATA**\n"],"metadata":{"id":"OVAdmo5MyIPL"}},{"cell_type":"code","source":["\n","#Cargar dataset\n","df = pd.read_csv('/content/drive/MyDrive/2026_Arianna_y_Barbara/Datasets /Financiero/btcusd_1-min_data.csv')\n","\n","#Convertir Timestamp (segundos Unix) a formato de fecha legible\n","df['Timestamp'] = pd.to_datetime(df['Timestamp'], unit='s')\n","\n","#Establecer la columna 'Timestamp' como índice\n","df.set_index('Timestamp', inplace=True)\n","\n","print(\"Dataset cargado exitosamente. Primeras filas:\")\n","\n","#Limpieza de datos\n","df.columns = df.columns.str.strip()\n","#Manejo de datos nulos. Usamos Forward Fiil si un minuto no tuvo transacciones, el precio se mantiene igualdf.fillna(method='ffill', inplace=True)\n","#Remuestreo diario, lo convertimos a frecuencia diaria ('D)\n","df = df.resample('D').agg({\n","    'Open' : 'first',\n","    'High' : 'max',\n","    'Low' : 'min',\n","    'Close' : 'last',\n","    'Volume' : 'sum'\n","})\n","\n","df = df.sort_index()\n","df.dropna(inplace=True)\n","print(\"\\nDataset de Bitcoin adaptado a frecuencia DIARIA:\")\n","df.head()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":350},"id":"99rDKVyvsRk4","executionInfo":{"status":"ok","timestamp":1775764871715,"user_tz":360,"elapsed":16748,"user":{"displayName":"ARIANNA MONSERRATT HURTADO RAMOS","userId":"12283955907500007694"}},"outputId":"02e70153-b0b9-41ab-9882-97fa51bffeb2"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Dataset cargado exitosamente. Primeras filas:\n"]},{"output_type":"stream","name":"stderr","text":["/