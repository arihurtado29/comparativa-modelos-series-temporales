x) #Ajustado para series temporales\n","  for dim in mlp_units:\n","    x = layers.Dense(dim, activation=\"relu\")(x)\n","    x = layers.Dropout(mlp_dropout)(x)\n","\n","  outputs = layers.Dense(1)(x) #Predicción del precio\n","  return models.Model(inputs, outputs)\n","\n","#Configuración para 20 días\n","input_shape = (look_back, 1)\n","\n","model_trans = build_transformer(input_shape, head_size=64, num_heads=2, ff_dim=2, num_transformer_blocks=2, mlp_units=[64], dropout=0.1)\n","\n","model_trans.compile(loss=\"mean_squared_error\", optimizer='adam')\n","\n","#Entrenamiento\n","print(f\"Entrenando Transformer...\")\n","model_trans.fit(X_train, y_train, epochs=30, batch_size=4, verbose=1)\n","\n","#Predicción y Desencalado\n","test_predict_trans = model_trans.predict(X_test)\n","test_predict_trans = scaler.inverse_transform(test_predict_trans)\n","\n","print(\"Transformer completado y datos escalados\")\n","\n","#Resultados\n","print(f\"Valor Real final: {y_test_real[-1][0]:.2f}\")\n","print(f\"Predicción final Transformer: {test_predict_trans[-1][0]:.2f}\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"6o2Gumoy19ng","outputId":"6c9b2bcd-96c4-4ab9-d5d4-a7ae34352039","executionInfo":{"status":"ok","timestamp":1775776777273,"user_tz":360,"elapsed":141816,"user":{"displayName":"ARIANNA MONSERRATT HURTADO RAMOS","userId":"12283955907500007694"}}},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Entrenando Transformer...\n","Epoch 1/30\n","\u001b[1m570/570\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m12s\u001b[0m 7ms/step - loss: 0.0043\n","Epoch 2/30\n","\u001b[1m570/570\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m4s\u001b[0m 6ms/step - loss: 0.0036\n","Epoch 3/30\n","\u001b[1m570/570\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m4s\u001b[0m 8ms/step - loss: 0.0035\n","Epoch 4/30\n","\u001b[1m570/570\u001b[0m \u001b[32